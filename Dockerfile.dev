FROM php:8.2-fpm-alpine

# Instalar dependências do sistema
RUN apk add --no-cache \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    sqlite \
    sqlite-dev \
    nodejs \
    npm \
    supervisor \
    bash

# Instalar extensões do PHP
RUN docker-php-ext-install \
    pdo_sqlite \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    opcache

# Configurar PHP para desenvolvimento
RUN echo "memory_limit = 512M" >> /usr/local/etc/php/conf.d/docker-php-memlimit.ini \
    && echo "max_execution_time = 300" >> /usr/local/etc/php/conf.d/docker-php-maxtime.ini \
    && echo "upload_max_filesize = 100M" >> /usr/local/etc/php/conf.d/docker-php-uploads.ini \
    && echo "post_max_size = 100M" >> /usr/local/etc/php/conf.d/docker-php-uploads.ini

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Criar usuário para a aplicação Laravel
RUN addgroup -g 1000 www && \
    adduser -u 1000 -G www -s /bin/sh -D www

# Definir diretório de trabalho
WORKDIR /var/www

# Instalar dependências globais do Node.js
RUN npm install -g concurrently

# Configurar permissões básicas
RUN chown -R www:www /var/www

# Configuração do Supervisor para desenvolvimento
COPY docker/supervisord.dev.conf /etc/supervisor/conf.d/supervisord.conf

# Configuração do PHP-FPM
COPY docker/php-fpm.conf /usr/local/etc/php-fpm.d/www.conf

# Script de inicialização para desenvolvimento
COPY docker/start-dev.sh /usr/local/bin/start-dev.sh
RUN chmod +x /usr/local/bin/start-dev.sh

# Expor portas
EXPOSE 9000 5173

# Mudar para usuário www
USER www

CMD ["/usr/local/bin/start-dev.sh"]
